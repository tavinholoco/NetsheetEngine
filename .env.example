# ============================================================
# NETSHEET ENGINE — VARIÁVEIS DE AMBIENTE (Fase 10, T10.1/T10.2)
# ============================================================
# Copie para `.env.local` no desenvolvimento. Na nuvem (Railway,
# Fly.io, Render), defina as mesmas chaves como variables/secrets da
# plataforma. NUNCA commite valores reais (o gitleaks do CI bloqueia).
#
# O cliente (bundle Vite) só enxerga o que começa com VITE_ — são
# INLINE no build, por isso precisam existir no momento do build.
# As demais são lidas pelo servidor em RUNTIME.
# ============================================================

# ---------- Build do cliente (inline no bundle Vite) ----------
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# Backend do multiplayer (T10.2) — OBRIGATÓRIO quando o frontend é estático
# (Vercel/Netlify) e o Express/WS vive em outra origem. Ex.:
# VITE_API_URL=https://netsheet-api.onrender.com  (apenas ORIGIN, sem path)
# Vazio = mesmo origin (SPA servida pelo próprio Express — deploy atual).
# REST/SSE/WS derivam desta base; o servidor já responde CORS em /api/*.
VITE_API_URL=

# ---------- Runtime do servidor ----------
# URL + service role do Supabase (persistência de salas — Fase 3).
# A service role bypassa a RLS: mantenha SEMPRE como secret.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Chave da API Gemini (Netrunner AI — /api/gemini)
GEMINI_API_KEY=

# ---------- Opcional ----------
# Porta/host do servidor (as plataformas injetam PORT automaticamente)
PORT=3000
HOST=0.0.0.0

# Timeout de isOnline dos jogadores na mesa (T3.4) — ms
# ROOM_OFFLINE_TIMEOUT_MS=60000
