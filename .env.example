[TEMPLATE]
# ============================================================
# NETSHEET ENGINE — Variáveis de Ambiente
# Copie este arquivo para `.env.local` e preencha os valores.
# ============================================================

# Chave da API Gemini (usada pelo servidor em /api/gemini)
GEMINI_API_KEY=

# Supabase (migração planejada na Fase 2 — Firebase hoje)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Supabase — chaves do SERVIDOR (Fase 3: persistência de salas)
# ⚠️ NUNCA prefixar com VITE_ (seria exposto ao cliente). A service
# role key bypassa RLS — só o servidor Express deve tê-la.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
